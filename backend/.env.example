# Environment variables for AgriSense AI Backend
# Create a copy of this file, rename it to '.env', and fill in your actual values.

# The connection string for your MongoDB Atlas cluster
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string_here

# The name of the database to use
DATABASE_NAME=agrisense_db
